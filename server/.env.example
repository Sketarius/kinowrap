# Copy this file to ".env" (same folder) and fill in your key. NEVER commit ".env".
# The app reads it when the server starts, so restart after changing anything here.

# Required. Create a pay-as-you-go key at https://platform.minimax.io -> Account -> API Keys.
# (If you only use the free Local model you can leave the placeholder; MiniMax jobs just won't work.)
MINIMAX_API_KEY=paste-your-key-here

# Spending cap used until you sync your real balance (click the balance pill in the app).
MAX_SPEND_USD=25

# Optional: refuse new jobs once this much has been spent today (local time). 0 or unset = no daily limit.
# MAX_DAILY_USD=10

# Optional: show a low-balance warning below this amount (default 3).
# LOW_BALANCE_USD=3

# Optional: the server's port (default 3000). If you change it, update client/proxy.conf.json too.
# PORT=3000

# Optional: override the MiniMax API address (default https://api.minimax.io, the international platform).
# MINIMAX_BASE_URL=https://api.minimax.io

# ---- Local model and upscalers (optional; see docs/local.md; check and set up with: npm run local -- status) ----

# Folder with the local H3 install (h3.py and a venv). Default: ../h3-local, next to this project.
# LOCAL_H3_DIR=C:/Repo/h3-local

# Denoising steps for local jobs. More steps is slower and a bit more refined (default 20; 10 is fine for drafts).
# LOCAL_H3_STEPS=20

# Longest local clip in seconds (default 10). Local 768p is always limited to 5 seconds.
# LOCAL_H3_MAX_SECONDS=10

# Folder holding the upscaler programs (esrgan, realcugan, waifu2x, seedvr2) behind the "Upscale to 768p" button on local clips.
# Default: <LOCAL_H3_DIR>/tools
# LOCAL_UPSCALERS_DIR=C:/Repo/h3-local/tools
